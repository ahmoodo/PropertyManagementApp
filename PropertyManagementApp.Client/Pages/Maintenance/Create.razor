@page "/maintenance/create"
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>New Maintenance Project</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">New Maintenance Project</MudText>

<MudCard Style="max-width:600px;">
    <MudCardContent>
        <MudTextField @bind-Value="_project.Title" Label="Project Title" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_project.Description" Label="Description" Lines="3" Class="mb-3" />
        <MudSelect @bind-Value="_project.PropertyId" Label="Property" Required="true" Class="mb-3">
            @foreach (var p in _properties)
            {
                <MudSelectItem Value="@p.Id">@p.Name — @p.Address</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_project.Vendor" Label="Vendor / Contractor" Class="mb-3" />
        <MudNumericField @bind-Value="_project.BidAmount" Label="Bid Amount" Min="0m" Format="F2"
                         Adornment="Adornment.Start" AdornmentText="$" Class="mb-3" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/maintenance"))">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Class="ml-2">Create Project</MudButton>
    </MudCardActions>
</MudCard>

@code {
    MaintenanceProjectDto _project = new();
    List<PropertyDto> _properties = new();

    protected override async Task OnInitializedAsync()
    {
        _properties = await Http.GetFromJsonAsync<List<PropertyDto>>("api/properties") ?? new();
    }

    async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_project.Title)) return;

        // set property address for display
        var prop = _properties.FirstOrDefault(p => p.Id == _project.PropertyId);
        if (prop != null) _project.PropertyAddress = prop.Address;

        var resp = await Http.PostAsJsonAsync("api/maintenanceprojects", _project);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Project created!", Severity.Success);
            Nav.NavigateTo("/maintenance");
        }
    }
}
