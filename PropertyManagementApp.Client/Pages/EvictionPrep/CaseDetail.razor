@page "/eviction-prep/{CaseId:int}"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Eviction Case Detail</PageTitle>
<ApiError Message="@_error" />
<DisclaimerBanner />

@if (_case == null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudText Typo="Typo.h5">Case #@_case.Id — @_case.TenantName</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachFile"
                   OnClick="AttachEvidence">Attach Evidence</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Archive"
                   OnClick="ExportCasePackage" Class="ml-2">Export Case Package</MudButton>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mb-4">@_case.PropertyAddress | Opened @_case.CaseOpenDate.ToString("MMM d, yyyy") | @_case.DaysElapsed days elapsed</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">Eviction Timeline</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EvictionTimeline Steps="@_case.Steps" OnStepToggle="ToggleStep" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">Documents & Notices</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_case.Notices.Any())
                    {
                        <MudList T="EvictionNoticeDto" Dense="true">
                            @foreach (var n in _case.Notices)
                            {
                                <MudListItem T="EvictionNoticeDto">
                                    <MudText Typo="Typo.body2"><b>@n.Type</b> — @n.CreatedAt.ToString("MMM d, yyyy")</MudText>
                                    <MudText Typo="Typo.caption">Delivery: @n.DeliveryMethod</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary" Class="mb-3">No notices generated yet.</MudText>
                    }

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Generate a Notice</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   Href="@($"/eviction-prep/{CaseId}/notice/late-rent-notice")">Late Rent Notice</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   Href="@($"/eviction-prep/{CaseId}/notice/pay-or-quit-3day")">3-Day Pay or Quit</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   Href="@($"/eviction-prep/{CaseId}/notice/pay-or-quit-5day")">5-Day Pay or Quit</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   Href="@($"/eviction-prep/{CaseId}/notice/unconditional-quit")">Unconditional Quit</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    string? _error;
    [Parameter] public int CaseId { get; set; }
    EvictionCaseDto? _case;

    protected override async Task OnInitializedAsync()
    {
        try
        {
        _case = await Http.GetFromJsonAsync<EvictionCaseDto>($"api/evictioncases/{CaseId}");
        }
        catch (Exception ex)
        {
            _error = $"Could not connect to API: {ex.Message}";
        }
    }

    async Task ToggleStep(EvictionStepDto step)
    {
        await Http.PutAsync($"api/evictioncases/{CaseId}/steps/{step.Id}", null);
        step.IsComplete = !step.IsComplete;
        step.CompletedAt = step.IsComplete ? DateTime.Now : null;
        Snackbar.Add(step.IsComplete ? $"Step completed: {step.Label}" : "Step unchecked", Severity.Info);
    }

    async Task AttachEvidence()
    {
        if (_case == null) return;
        // pull rent ledger CSV + communication log and bundle as attached evidence
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("=== EVIDENCE PACKAGE — CASE " + _case.Id + " ===");
        sb.AppendLine();
        sb.AppendLine("--- RENT LEDGER ---");
        try
        {
            var schedules = await Http.GetFromJsonAsync<List<RentScheduleDto>>($"api/rentschedules?tenantId={_case.TenantId}");
            var payments = await Http.GetFromJsonAsync<List<RentPaymentDto>>($"api/rentpayments?tenantId={_case.TenantId}");
            sb.AppendLine("Date,Description,Charge,Payment");
            foreach (var s in schedules ?? new())
                sb.AppendLine($"{s.DueDate:yyyy-MM-dd},Rent {s.Month},{(s.BaseRent + s.LateFee):F2},");
            foreach (var p in payments ?? new())
                sb.AppendLine($"{p.PaymentDate:yyyy-MM-dd},{p.PaymentMethod} Payment,,{p.AmountPaid:F2}");

            sb.AppendLine();
            sb.AppendLine("--- COMMUNICATION LOG ---");
            var comms = await Http.GetFromJsonAsync<List<CommunicationLogDto>>($"api/communications?tenantId={_case.TenantId}");
            foreach (var c in comms ?? new())
                sb.AppendLine($"{c.SentAt:yyyy-MM-dd HH:mm} [{c.Type}] {c.Message}");

            await JS.InvokeVoidAsync("downloadFile", $"evidence-case-{_case.Id}.txt", sb.ToString(), "text/plain");
            Snackbar.Add("Evidence package downloaded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to attach evidence: {ex.Message}", Severity.Error);
        }
    }

    async Task ExportCasePackage()
    {
        if (_case == null) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"EVICTION CASE PACKAGE — Case #{_case.Id}");
        sb.AppendLine($"Tenant: {_case.TenantName}");
        sb.AppendLine($"Property: {_case.PropertyAddress}");
        sb.AppendLine($"Reason: {_case.Reason}");
        sb.AppendLine($"Opened: {_case.CaseOpenDate:MMM d, yyyy}");
        sb.AppendLine($"Days Elapsed: {_case.DaysElapsed}");
        sb.AppendLine();
        sb.AppendLine("--- TIMELINE ---");
        foreach (var s in _case.Steps.OrderBy(s => s.Order))
        {
            var mark = s.IsComplete ? "[X]" : "[ ]";
            sb.AppendLine($"{mark} {s.Label} ({s.TypicalTiming})");
            if (s.IsComplete && s.CompletedAt.HasValue)
                sb.AppendLine($"     Completed: {s.CompletedAt:MMM d, yyyy}");
        }
        sb.AppendLine();
        sb.AppendLine("--- NOTICES ---");
        foreach (var n in _case.Notices)
        {
            sb.AppendLine($"[{n.Type}] {n.CreatedAt:MMM d, yyyy} via {n.DeliveryMethod}");
            sb.AppendLine(n.NoticeText);
            sb.AppendLine(new string('-', 40));
        }
        await JS.InvokeVoidAsync("downloadFile", $"case-package-{_case.Id}.txt", sb.ToString(), "text/plain");
        Snackbar.Add("Case package exported.", Severity.Success);
    }
}
